# Server-only environment variables (DO NOT use NEXT_PUBLIC_ prefix)
# Set these in Vercel project settings or local .env.local

# Sanctum API key for LST data and swap quotes
SANCTUM_API_KEY=

# Solana RPC endpoint (fallback: https://api.mainnet-beta.solana.com)
SOLANA_RPC_URL=

# Optional: Comma-separated list of allowed origins for RPC proxy
# Example: https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# Optional: Public WebSocket endpoint for wallet adapter (must be keyless)
# Default: wss://api.mainnet-beta.solana.com
# NEXT_PUBLIC_SOLANA_WS_URL=
